# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JUDGE0_API_KEY: Optional RapidAPI key if using external Judge0 multi-language compiler runner
# Get a free key at: https://rapidapi.com/judge0-official/api/judge0-ce
VITE_JUDGE0_API_KEY=""
VITE_JUDGE0_ENDPOINT="https://judge0-ce.p.rapidapi.com"
